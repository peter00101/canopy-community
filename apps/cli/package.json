{
  "name": "@canopy/cli",
  "version": "0.1.1",
  "license": "AGPL-3.0-only",
  "description": "canopy — Canopy 命令行工具。面向有限上下文的 Agent 消费者，提供会话的渐进式读取（list / info / outline / search / export）。",
  "type": "module",
  "bin": {
    "canopy": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile dist/canopy src/index.ts",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@canopy/brand": "workspace:*",
    "@canopy/session-core": "workspace:*",
    "@canopy/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
